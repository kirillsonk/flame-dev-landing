# Боевой сервер в РФ ходит в OpenAI и Telegram через ретранслятор в Европе (relay/)
# Нужны только эти две переменные, внешние ключи хранятся на ретрансляторе
RELAY_URL=
RELAY_SECRET=
OPENAI_MODEL=gpt-6-luna

# Локальная разработка без ретранслятора: прямые ключи
# Сайт и демо работают и без них
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
OPENAI_API_KEY=
